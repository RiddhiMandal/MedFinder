<% content_for :title, "#{@conversation.display_title} · Supplement Agent" %>
<%= turbo_stream_from @conversation %>

<div class="flex flex-col gap-8 md:flex-row">
  <%= render "sidebar", conversations: @conversations, current: @conversation %>

  <section class="flex min-h-[70vh] flex-1 flex-col rounded-xl border border-stone-200 bg-white" data-controller="chat">
    <div id="messages" class="flex-1 space-y-5 overflow-y-auto p-6" data-chat-target="messages">
      <% if @conversation.messages.empty? %>
        <div id="empty_state" class="text-stone-600">
          <p class="font-medium text-stone-800">Try one of these:</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <% [
                 "Which magnesium is best for sleep, and do you have one in stock?",
                 "I take warfarin. Is fish oil OK?",
                 "I'm vegan. What B12 and omega-3 options are under $20?",
                 "Can I take iron and calcium together?"
               ].each do |q| %>
              <button type="button" data-action="chat#ask" data-question="<%= q %>"
                      class="rounded-full border border-stone-300 px-3 py-1.5 text-sm hover:border-emerald-600 hover:text-emerald-700">
                <%= q %>
              </button>
            <% end %>
          </div>
        </div>
      <% end %>
      <%= render @conversation.messages %>
    </div>

    <%= form_with model: [@conversation, Message.new], id: "message_form",
          class: "flex gap-2 border-t border-stone-200 p-4",
          data: { chat_target: "form", action: "turbo:submit-end->chat#reset" } do |f| %>
      <%= f.text_area :body, rows: 1, required: true, placeholder: "Ask about a supplement, a product, or a combination…",
            class: "flex-1 resize-none rounded-lg border border-stone-300 px-3 py-2 focus:border-emerald-600 focus:outline-none",
            data: { chat_target: "input", action: "keydown.enter->chat#submit" } %>
      <%= f.submit "Ask", class: "rounded-lg bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-700 disabled:opacity-50" %>
    <% end %>
  </section>
</div>
