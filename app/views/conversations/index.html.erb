<div class="flex flex-col gap-8 md:flex-row">
  <%= render "sidebar", conversations: @conversations, current: nil %>

  <section class="flex-1 rounded-xl border border-stone-200 bg-white p-8">
    <h1 class="text-2xl font-semibold">Ask about supplements</h1>
    <p class="mt-2 max-w-prose text-stone-600">
      An AI agent built with Ruby on Rails and Claude. It answers from a small knowledge base,
      looks up products and interactions in the database, and shows each step it took.
    </p>
    <ul class="mt-6 grid gap-3 text-sm sm:grid-cols-3">
      <li class="rounded-lg bg-stone-100 p-3"><strong>search_knowledge_base</strong><br>Short articles on forms, doses and safety</li>
      <li class="rounded-lg bg-stone-100 p-3"><strong>search_products</strong><br>Catalog lookup with price and stock filters</li>
      <li class="rounded-lg bg-stone-100 p-3"><strong>check_interactions</strong><br>Known supplement and medication interactions</li>
    </ul>
    <%= button_to "Start a conversation", conversations_path,
          class: "mt-8 rounded-lg bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-700" %>
  </section>
</div>
